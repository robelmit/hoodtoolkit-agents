{
  "name": "@hood-toolkit/mcp",
  "version": "0.1.0",
  "description": "A read-only MCP server for Robinhood Chain launchpad tokens: read a Pons token and its curve, quote a trade, list its recent trades and recent launches. Runs over stdio or HTTP, holds no key, and has no tool that signs or sends.",
  "license": "MIT",
  "keywords": [
    "robinhood-chain",
    "pons",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "launchpad",
    "read-only"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hoodtoolkit-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@hood-toolkit/bot-core": "^0.1.0",
    "@hood-toolkit/evm": "^0.1.0",
    "@hood-toolkit/pons": "^0.1.0"
  },
  "peerDependencies": {
    "ioredis": ">=5"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
