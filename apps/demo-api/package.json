{
  "name": "@hoodtoolkit/demo-api",
  "version": "0.1.0",
  "private": true,
  "description": "A small, rate-limited, read-only HTTP API over the hoodtoolkit tools for Robinhood Chain: Pons tokens, quotes, trades and launches, any token, and the MCP endpoint.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf .turbo"
  },
  "dependencies": {
    "@hoodtoolkit/bot-core": "^0.1.0",
    "@hoodtoolkit/evm": "^0.1.0",
    "@hoodtoolkit/mcp": "workspace:^",
    "ioredis": "^6.0.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@hoodtoolkit/pons": "^0.1.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
